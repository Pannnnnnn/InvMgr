# Supabase project (cloud) — Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, never expose to the client/browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket used for worker checkout photos
SUPABASE_STORAGE_BUCKET=worker-photos

# Google Gemini (multimodal LLM) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# Signed URL TTL (seconds) for worker photos returned to the UI
SIGNED_URL_TTL_SECONDS=300
